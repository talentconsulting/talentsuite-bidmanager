@namespace TalentSuite.FrontEnd.Pages.Bids.Management.Tabs
@using TalentSuite.FrontEnd.Pages.Bids.Management.Models
@using TalentSuite.Shared.Bids

<div class="card shadow-sm chat-panel @(IsExpanded ? "chat-panel--expanded" : null)">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="mb-0">Chat</h5>
            <div class="d-flex gap-2">
                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="ToggleExpanded"
                        aria-expanded="@IsExpanded"
                        title="@(IsExpanded ? "Reduce chat" : "Expand chat to full page")">
                    <span aria-hidden="true">@(IsExpanded ? "↙" : "⛶")</span>
                    @(IsExpanded ? "Reduce" : "Expand")
                </button>
                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="OnSubmitChat"
                        disabled="@IsBusy">
                    @(IsBusy ? "Streaming…" : "Submit")
                </button>
            </div>
        </div>

        <label class="form-label fw-bold">Question</label>
        <textarea class="form-control"
                  rows="3"
                  value="@ChatQuestionText"
                  @oninput="e => OnChatQuestionTextChanged.InvokeAsync(e.Value?.ToString())"
                  disabled="@IsBusy"
                  @onkeydown="OnQuestionKeyDown"></textarea>

        <div class="mt-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <label class="form-label fw-bold mb-0">Files to include</label>
                @if (BidFiles.Count > 0)
                {
                    <span class="small text-muted">Select up to @MaxSelectedFiles</span>
                }
            </div>
            @if (BidFiles.Count == 0)
            {
                <div class="small text-muted">No files have been uploaded for this bid.</div>
            }
            else
            {
                <div class="border rounded p-2 file-selection-list">
                    @foreach (var file in BidFiles)
                    {
                        var isSelected = SelectedFileIds.Contains(file.Id, StringComparer.OrdinalIgnoreCase);
                        var selectionLimitReached = !isSelected && SelectedFileIds.Count >= MaxSelectedFiles;
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   id="@GetFileCheckboxId(file.Id)"
                                   checked="@isSelected"
                                   disabled="@(IsBusy || selectionLimitReached)"
                                   @onchange="() => OnFileSelectionToggled.InvokeAsync(file.Id)" />
                            <label class="form-check-label text-break" for="@GetFileCheckboxId(file.Id)">
                                @file.FileName
                            </label>
                        </div>
                    }
                </div>
            }
        </div>

        <label class="form-label fw-bold mt-3">Response</label>
        <div class="border rounded p-3 bg-light chat-response"
             id="@ChatScrollContainerId">
            @if (Question.ChatMessages.Count == 0)
            {
                <div class="text-muted">No chat history yet.</div>
            }
            else
            {
                @foreach (var message in Question.ChatMessages)
                {
                    var isAssistant = string.Equals(message.Role, "assistant", StringComparison.OrdinalIgnoreCase);
                    <div class="mb-3">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <div class="small text-muted text-uppercase fw-bold">@message.Role</div>
                            <div class="small text-muted">@message.CreatedAtUtc.ToLocalTime().ToString("g")</div>
                        </div>
                        <div class="border rounded p-3 bg-white">
                            <div style="white-space: pre-wrap;">@message.Content</div>
                        </div>
                        @if (isAssistant)
                        {
                            <div class="border rounded bg-light px-3 py-2 mb-3">
                                <div class="small text-uppercase text-muted fw-bold mb-2">Sources</div>
                                @if (message.Sources.Count > 0)
                                {
                                    <ul class="mb-0 ps-3 small">
                                        @foreach (var source in message.Sources)
                                        {
                                            <li class="mb-1">
                                                @if (!string.IsNullOrWhiteSpace(source.FileName))
                                                {
                                                    <span>@source.FileName</span>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(source.Title))
                                                {
                                                    <span>@source.Title</span>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(source.Uri))
                                                {
                                                    <span>@source.Uri</span>
                                                }
                                                else
                                                {
                                                    <span>Unknown source</span>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(source.Quote))
                                                {
                                                    <div class="text-muted mt-1">
                                                        <span class="fw-semibold">Cited text:</span>
                                                        <div>"@source.Quote"</div>
                                                    </div>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="small text-muted">No source metadata returned for this answer.</div>
                                }

                                @if (message.UsedSourcesOutsideBidLibrary)
                                {
                                    <div class="text-warning-emphasis small mt-2">
                                        This answer used sources outside the bid library.
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-end gap-3 mt-1">
                                <small class="text-muted">@ResponseWordCount(message.Content) words</small>
                                <small class="text-muted">@ResponseCharCountWithSpaces(message.Content) chars (inc. spaces)</small>
                                <small class="text-muted">@ResponseCharCountNoSpaces(message.Content) chars (exc. spaces)</small>
                            </div>
                            <div class="mt-2">
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm"
                                        @onclick="() => OnAddChatToDrafts.InvokeAsync(message.Content)"
                                        disabled="@(IsDraftBusy || Question.IsChatStreaming)">
                                    @(IsDraftBusy ? "Adding…" : "Add to drafts")
                                </button>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public BidQuestionModel Question { get; set; } = default!;
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool IsDraftBusy { get; set; }
    [Parameter] public string? ChatQuestionText { get; set; }
    [Parameter] public string ChatScrollContainerId { get; set; } = string.Empty;
    [Parameter] public IReadOnlyList<BidFileResponse> BidFiles { get; set; } = [];
    [Parameter] public IReadOnlyCollection<string> SelectedFileIds { get; set; } = [];
    [Parameter] public EventCallback<string?> OnChatQuestionTextChanged { get; set; }
    [Parameter] public EventCallback<string> OnFileSelectionToggled { get; set; }
    [Parameter] public EventCallback OnSubmitChat { get; set; }
    [Parameter] public EventCallback<string> OnAddChatToDrafts { get; set; }

    private const int MaxSelectedFiles = 4;

    private bool IsExpanded { get; set; }

    private void ToggleExpanded() => IsExpanded = !IsExpanded;

    private string GetFileCheckboxId(string fileId) => $"chat-file-{Question.Id}-{fileId}";

    private static int ResponseWordCount(string? content) =>
        string.IsNullOrWhiteSpace(content) ? 0 : content.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;

    private static int ResponseCharCountWithSpaces(string? content) => content?.Length ?? 0;

    private static int ResponseCharCountNoSpaces(string? content) => content?.Count(c => !char.IsWhiteSpace(c)) ?? 0;

    private async Task OnQuestionKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey)
        {
            await OnSubmitChat.InvokeAsync();
        }
    }
}
